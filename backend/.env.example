# ============================================================
# CONTOH KONFIGURASI ENVIRONMENT
# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN commit file ".env" yang asli (sudah di-ignore).
# ============================================================

# --- Keamanan ---
# WAJIB kunci baru & rahasia di production. Generate dengan:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ganti-dengan-kunci-baru-yang-di-generate

# Production WAJIB False
DEBUG=False

# Domain yang diizinkan (pisah dengan koma)
ALLOWED_HOSTS=imogi.co.id,www.imogi.co.id

# Origin tepercaya CSRF (dengan https://)
CSRF_TRUSTED_ORIGINS=https://imogi.co.id,https://www.imogi.co.id

# --- Email SMTP (Gmail) ---
# Buat "App Password" di akun Google:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# lalu tempel 16 digitnya (tanpa spasi) di EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=imogi.indonesia@gmail.com
EMAIL_HOST_PASSWORD=app-password-16-digit
DEFAULT_FROM_EMAIL=Imogi Indonesia <imogi.indonesia@gmail.com>
CONTACT_NOTIFY_EMAIL=imogi.indonesia@gmail.com

# --- Google Analytics ---
GOOGLE_ANALYTICS_ID=G-VTW7CBNJWW
